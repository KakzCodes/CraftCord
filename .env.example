# Copy this file to .env and fill in the values below, then run:
#   docker compose up --build

# --- Discord -------------------------------------------------------------------
DISCORD_TOKEN=

# Optional. If set, slash commands sync to this guild only (near-instant —
# ideal for development). Leave blank to sync globally, which can take up
# to an hour to propagate to every server CraftCord is in.
DISCORD_GUILD_ID_DEV=

# --- Pterodactyl (client API) -------------------------------------------------
PTERODACTYL_URL=https://panel.example.com
# A Pterodactyl *client* API key (Account Settings -> API Credentials),
# NOT an application/admin key. Must start with ptlc_.
PTERODACTYL_API_KEY=ptlc_

# --- Pterodactyl (application API — optional, enables /admin create-server) ---
# Leave every line in this section blank/unset if you only plan to link
# servers you create manually on the panel via /admin register-server.
# /admin create-server stays disabled until every value below is set.
#
# An *application* key (Admin -> Application API), NOT a client key.
# Must start with ptla_. Treat this like a panel admin password — it can
# create/modify any server on the panel.
PTERODACTYL_APPLICATION_API_KEY=
# The Pterodactyl panel USER ID that newly created servers will belong to.
PTERODACTYL_OWNER_USER_ID=
# The egg ID (Admin -> Nests) new servers are built from, e.g. a Paper egg.
PTERODACTYL_EGG_ID=
PTERODACTYL_DOCKER_IMAGE=ghcr.io/pterodactyl/yolks:java_21
PTERODACTYL_STARTUP_COMMAND=java -Xms128M -Xmx{{SERVER_MEMORY}}M -jar {{SERVER_JARFILE}}
# Raw JSON object of the egg's environment variables — these vary by egg,
# so check the egg's own variable list on your panel.
PTERODACTYL_CREATE_ENVIRONMENT={"SERVER_JARFILE":"server.jar","MINECRAFT_VERSION":"1.20.4"}
PTERODACTYL_MEMORY_MB=2048
PTERODACTYL_SWAP_MB=0
PTERODACTYL_DISK_MB=10240
# 0 = unlimited CPU.
PTERODACTYL_CPU_PERCENT=0
PTERODACTYL_IO_WEIGHT=500
PTERODACTYL_DATABASES_LIMIT=0
PTERODACTYL_BACKUPS_LIMIT=0
# Comma-separated location IDs (Admin -> Locations) Pterodactyl may
# auto-deploy new servers into, e.g. "1,2".
PTERODACTYL_DEPLOY_LOCATION_IDS=
# Stored in CraftCord's own DB for display in /server info — purely
# cosmetic, doesn't affect which version actually gets installed (that's
# controlled by PTERODACTYL_CREATE_ENVIRONMENT above).
PTERODACTYL_DEFAULT_MC_VERSION=1.20.4

# --- Database ----------------------------------------------------------------
# NOTE: keep the user/password/db name here in sync with POSTGRES_USER /
# POSTGRES_PASSWORD below — docker-compose's `db` service and the `bot`
# service's DATABASE_URL are two separate settings that both read from
# this same file, so they must agree manually.
DATABASE_URL=postgresql+asyncpg://craftcord:changeme@db:5432/craftcord
POSTGRES_USER=craftcord
POSTGRES_PASSWORD=changeme

# --- RCON ------------------------------------------------------------------
# The hostname here is the Docker network alias (or external host) of your
# Minecraft server's container, not the Pterodactyl panel itself.
RCON_HOST=mc-server
RCON_PORT=25575
RCON_PASSWORD=changeme

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO
# json for production (structured, log-aggregator friendly); console for
# a human-readable, colorized format during local development.
LOG_FORMAT=json
